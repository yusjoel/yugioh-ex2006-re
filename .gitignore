# 构建输出
*.o
*.elf
*.gba

# IDE
.vscode/
.idea/
# .claude/ 默认忽略 settings 等本地文件, 但 skills/ + agents/ 入库 (项目共享方法论)
.claude/*
!.claude/skills/
!.claude/agents/

# 临时文件
*.tmp
*.log
*.bak-*
/ghidra/
doc/temp/
temp/
__pycache__/

# build 日志重定向 scratch (agent 临时捕获, 非源; ld_script.txt 是正式文件不在此列)
/build_out*.txt
/build_err*.txt
/build_output.txt

# asm/all.s 再生中间产物 (由 ghidra-export-range.bat → inject_modes.py 生成)
# all.s 现为 split_all_s.py 的输入中间产物; 入库的是拆分后的 asm/all/*.s
asm/all.s
asm/all.s.raw
asm/all.s.raw.nomode

# 视觉审阅 PNG (脚本可重新生成)
tools/card-desc/*.png

output/

# refs/ 参考目录：子目录本地使用，不纳入版本控制；README.md 保留版本管理
refs/ygocdb/
refs/agbcc/
refs/pokeruby/
refs/WCT2006BATTLECITY/
refs/mgba/
refs/awesome-gbadev/
refs/yugioh-card-search/
refs/gba-ghidra-loader/

# 导出的图形资产（由 tools/rom-export/export_gfx.py 从 ROM 生成）
graphics/

# 导出的数据汇编（由 tools/rom-export/export_all.py 从 ROM 生成）
data/

# 文本源 (UTF-8 中间产物) — 由 decode_s_to_txt 从 data/*.s 生成, encode 编回 data/*.s
# 真正的源头是 codetable.json (jp-decode/) + ROM (5 lang CP1252)
text/

# 导出的 FS 文件（由 tools/rom-export/export_fs_files.py 从 ROM 重建）
fs/

# 解压后的 NNS 容器（由 tools/rom-export/export_nns_unpacked.py 从 ROM 重建）
fs-decompressed/

# 本地环境配置（路径因机器而异）
LOCAL.md
roms/*.sav
roms/*.ss*
tools/arm-none-eabi-gdb.exe
tools/mgba-scripts/local-settings.ps1
env
refs/NitroSDK
refs/NitroSystem
refs/poptracker-ygo06
refs/stevexmh-nds-patch-walkthrough
refs/NITRO SDK v2.0RC3/
refs/NitroSDK-1_0-040416/
refs/NitroSDK-*.zip
