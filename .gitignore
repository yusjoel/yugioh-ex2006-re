# IDE
.vscode/
.idea/
.claude/

# 临时文件
*.tmp
*.log
/ghidra/
doc/temp/
temp/
__pycache__/

# 视觉审阅 PNG (脚本可重新生成)
tools/card-desc/*.png

output/

# refs/ 参考目录：子目录本地使用，不纳入版本控制；README.md 保留版本管理
refs/ygocdb/
refs/agbcc/
refs/pokeruby/
refs/WCT2006BATTLECITY/
refs/mgba/
